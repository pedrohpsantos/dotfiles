{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/pedrohpsantos/.config/fastfetch/alpine_logo.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    },
    "color": {
      "1": "#74c7ec",
      "2": "#89b4fa"
    }
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "#74c7ec",
      "title": "#94e2d5",
      "separator": "#585b70"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " OS      "
    },
    {
      "type": "host",
      "key": "󰌢 Host    "
    },
    {
      "type": "kernel",
      "key": " Kernel  "
    },
    {
      "type": "uptime",
      "key": " Uptime  "
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": " Shell   "
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "wm",
      "key": " WM/WSL  "
    },
    {
      "type": "cpu",
      "key": " CPU     "
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU     "
    },
    {
      "type": "memory",
      "key": " Memory  "
    },
    {
      "type": "disk",
      "key": "󰋊 Disk (/)",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

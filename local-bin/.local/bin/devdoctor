#!/bin/sh
# ==============================================================================
# ~/.local/bin/devdoctor — Workstation Diagnostic & Toolchain Presence Audit
# Note: Validates tool presence and basic configuration; does not perform
# end-to-end integration execution testing of containerized workloads.
# ==============================================================================
set -eu

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:$PATH"

ESC="$(printf '\033')"
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_MAUVE="${ESC}[38;2;203;166;247m"
C_BLUE="${ESC}[38;2;137;180;250m"
C_GREEN="${ESC}[38;2;166;227;161m"
C_YELLOW="${ESC}[38;2;249;226;175m"
C_RED="${ESC}[38;2;243;139;168m"
C_MUTED="${ESC}[38;2;166;173;200m"

PASS_COUNT=0
WARN_COUNT=0
SKIP_COUNT=0
FAIL_COUNT=0

row() {
    _domain="$1"
    _status="$2"
    _detail="$3"
    case "$_status" in
        PASS)
            _color="$C_GREEN"
            PASS_COUNT=$((PASS_COUNT + 1))
            ;;
        WARN)
            _color="$C_YELLOW"
            WARN_COUNT=$((WARN_COUNT + 1))
            ;;
        SKIP)
            _color="$C_MUTED"
            SKIP_COUNT=$((SKIP_COUNT + 1))
            ;;
        FAIL)
            _color="$C_RED"
            FAIL_COUNT=$((FAIL_COUNT + 1))
            ;;
        *)
            _color="$C_RESET"
            ;;
    esac
    printf "  %s%-18s%s %s%-16s%s %s\n" "$C_BLUE" "$_domain" "$C_RESET" "$_color" "[$_status]" "$C_RESET" "$_detail"
}

printf "\n%s%s╭──────────────────────────────────────────────────────────────────────────────╮%s\n" "$C_BOLD" "$C_MAUVE" "$C_RESET"
printf "%s%s│       PEDRO'S DEVELOPER WORKSTATION — DEVDOCTOR STATUS & CONFIG AUDIT        │%s\n" "$C_BOLD" "$C_MAUVE" "$C_RESET"
printf "%s%s╰──────────────────────────────────────────────────────────────────────────────╯%s\n\n" "$C_BOLD" "$C_MAUVE" "$C_RESET"

# 1. OS & Kernel
if [ -f /etc/alpine-release ]; then
    ALPINE_VER="$(cat /etc/alpine-release)"
    KERNEL_VER="$(uname -r)"
    DISK_INFO="$(df -h / | awk 'NR==2 {printf "%s used / %s avail (%s)", $3, $4, $5}')"
    row "OS & Kernel" "PASS" "Alpine $ALPINE_VER (musl x86_64) | Kernel $KERNEL_VER | Disk: $DISK_INFO"
else
    row "OS & Kernel" "FAIL" "Alpine Linux release file not detected"
fi

# 2. Shell & Terminal
if command -v zsh >/dev/null 2>&1 && command -v starship >/dev/null 2>&1 && command -v tmux >/dev/null 2>&1; then
    ZSH_VER="$(zsh --version | awk '{print $1, $2}')"
    STARSHIP_VER="$(starship --version | head -n 1 | awk '{print $2}')"
    TMUX_VER="$(tmux -V)"
    row "Shell & UX" "PASS" "$ZSH_VER | starship $STARSHIP_VER | $TMUX_VER"
else
    row "Shell & UX" "WARN" "One or more core shell tools missing (zsh, starship, tmux)"
fi

# 3. Editor & LSPs / Formatters
LSP_MISSING=""
for lsp in nvim clangd gopls rust-analyzer lua-language-server taplo ruff stylua shfmt; do
    if ! command -v "$lsp" >/dev/null 2>&1; then
        LSP_MISSING="$LSP_MISSING $lsp"
    fi
done
if [ -z "$LSP_MISSING" ]; then
    NVIM_VER="$(nvim --version | head -n 1 | awk '{print $2}')"
    row "Editor & LSPs" "PASS" "Neovim $NVIM_VER | LSPs: clangd, gopls, rust-analyzer, lua_ls, taplo | Format: ruff, stylua, shfmt"
else
    row "Editor & LSPs" "WARN" "Missing tools:$LSP_MISSING"
fi

# 4. GPU & CUDA Subsystem (Separated detection vs functional validation)
if [ -e /dev/dxg ] && command -v nvidia-smi >/dev/null 2>&1; then
    if GPU_SUMMARY="$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)" && \
       [ -n "$GPU_SUMMARY" ]; then
        GPU_SUMMARY="$(printf '%s\n' "$GPU_SUMMARY" | sed -n '1p')"
        row "GPU Detected" "PASS" "$GPU_SUMMARY (/dev/dxg present)"
    else
        row "GPU Detected" "WARN" "nvidia-smi failed to query GPU (/dev/dxg present)"
    fi
else
    row "GPU Detected" "WARN" "/dev/dxg device or nvidia-smi command unavailable"
fi

if [ -r /usr/lib/wsl/lib/libcuda.so.1 ]; then
    row "CUDA Driver Lib" "PASS" "/usr/lib/wsl/lib/libcuda.so.1 present (WSL driver interface)"
else
    row "CUDA Driver Lib" "WARN" "/usr/lib/wsl/lib/libcuda.so.1 not accessible"
fi

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    D_VER="$(docker --version | awk '{print $3}' | tr -d ',')"
    DC_VER="$(docker compose version --short 2>/dev/null || echo n/a)"
    row "Docker Engine" "PASS" "Docker Engine $D_VER | Compose v$DC_VER (daemon responding)"
else
    row "Docker Engine" "WARN" "Docker daemon not responding (start Docker Desktop on Windows)"
fi

if [ -x "$HOME/.local/bin/docker" ] && [ -e /dev/dxg ]; then
    row "Docker GPU Hook" "PASS" "Wrapper ~/.local/bin/docker configured to inject /dev/dxg and /usr/lib/wsl on --gpus"
else
    row "Docker GPU Hook" "WARN" "Wrapper or /dev/dxg unavailable"
fi

# Functional container execution is marked SKIP as devdoctor does not pull/run heavy container workloads
row "CUDA Container" "SKIP" "End-to-end container test not run (requires pulling CUDA image; see docs/ARCHITECTURE.md)"
row "PyTorch CUDA" "SKIP" "Requires containerized glibc workload (~/Projects/_templates/ai-gpu-cuda)"

# 5. Local LLM (Ollama)
if command -v ollama >/dev/null 2>&1; then
    OLLAMA_VER="$(ollama --version 2>/dev/null | tail -n 1 | awk '{print $NF}' || echo installed)"
    if ollama list >/dev/null 2>&1; then
        row "AI / Ollama" "PASS" "Windows Host Ollama ($OLLAMA_VER) reachable | Model: qwen3.5:4b"
    else
        row "AI / Ollama" "WARN" "Ollama CLI linked ($OLLAMA_VER), but host daemon is not responding"
    fi
else
    row "AI / Ollama" "SKIP" "Ollama binary wrapper not installed"
fi

# 6. Python Toolchain & OCR
PY_MISSING=""
for p in python3 uv ruff tesseract; do
    if ! command -v "$p" >/dev/null 2>&1; then
        PY_MISSING="$PY_MISSING $p"
    fi
done
if [ -z "$PY_MISSING" ]; then
    PY_VER="$(python3 --version | awk '{print $2}')"
    UV_VER="$(uv --version | awk '{print $2}')"
    RUFF_VER="$(ruff --version | awk '{print $2}')"
    row "Python & OCR" "PASS" "Python $PY_VER | uv $UV_VER | ruff $RUFF_VER | Tesseract OCR"
else
    row "Python & OCR" "WARN" "Missing tools:$PY_MISSING"
fi

# 7. Node / Frontend
NODE_MISSING=""
for n in node npm pnpm; do
    if ! command -v "$n" >/dev/null 2>&1; then
        NODE_MISSING="$NODE_MISSING $n"
    fi
done
if [ -z "$NODE_MISSING" ]; then
    NODE_VER="$(node -v)"
    PNPM_VER="$(pnpm -v)"
    row "Node.js" "PASS" "Node $NODE_VER | pnpm $PNPM_VER"
else
    row "Node.js" "WARN" "Missing tools:$NODE_MISSING"
fi

# 8. Go Toolchain
GO_MISSING=""
for g in go gopls dlv; do
    if ! command -v "$g" >/dev/null 2>&1; then
        GO_MISSING="$GO_MISSING $g"
    fi
done
if [ -z "$GO_MISSING" ]; then
    GO_VER="$(go version | awk '{print $3}')"
    GOPLS_VER="$(gopls version | head -n 1 | awk '{print $2}')"
    row "Go" "PASS" "$GO_VER | gopls $GOPLS_VER | delve"
else
    row "Go" "WARN" "Missing tools:$GO_MISSING"
fi

# 9. Rust Toolchain
RUST_MISSING=""
for r in rustc cargo rust-analyzer; do
    if ! command -v "$r" >/dev/null 2>&1; then
        RUST_MISSING="$RUST_MISSING $r"
    fi
done
if [ -z "$RUST_MISSING" ]; then
    RUST_VER="$(rustc --version | awk '{print $2}')"
    RA_VER="$(rust-analyzer --version | awk '{print $2}')"
    row "Rust" "PASS" "rustc $RUST_VER | cargo | rust-analyzer $RA_VER"
else
    row "Rust" "WARN" "Missing tools:$RUST_MISSING"
fi

# 10. Java Toolchain
if command -v java >/dev/null 2>&1 && command -v mvn >/dev/null 2>&1; then
    JAVA_VER="$(java -version 2>&1 | head -n 1 | awk -F '\"' '{print $2}')"
    MVN_VER="$(mvn -version | head -n 1 | awk '{print $3}')"
    row "Java" "PASS" "OpenJDK $JAVA_VER | Maven $MVN_VER"
else
    row "Java" "WARN" "OpenJDK or Maven missing"
fi

# 11. Cloud & IaC
IAC_MISSING=""
for c in tofu ansible helm kubectl; do
    if ! command -v "$c" >/dev/null 2>&1; then
        IAC_MISSING="$IAC_MISSING $c"
    fi
done
if [ -z "$IAC_MISSING" ]; then
    TOFU_VER="$(tofu --version | head -n 1 | awk '{print $2}')"
    HELM_VER="$(helm version --short | cut -d+ -f1)"
    row "Cloud & IaC" "PASS" "OpenTofu $TOFU_VER | Ansible | Helm $HELM_VER | kubectl"
else
    row "Cloud & IaC" "WARN" "Missing tools:$IAC_MISSING"
fi

# 12. Git & TUI Suite
GIT_MISSING=""
for tui in git gh lazygit lazydocker yazi btop delta; do
    if ! command -v "$tui" >/dev/null 2>&1; then
        GIT_MISSING="$GIT_MISSING $tui"
    fi
done
if [ -z "$GIT_MISSING" ]; then
    GIT_VER="$(git --version | awk '{print $3}')"
    row "Git & TUIs" "PASS" "git $GIT_VER | lazygit | lazydocker | yazi | btop | delta"
else
    row "Git & TUIs" "WARN" "Missing tools:$GIT_MISSING"
fi

# 13. Security Scanners
SEC_MISSING=""
for s in gitleaks trivy bandit pip-audit osv-scanner shellcheck actionlint hadolint; do
    if ! command -v "$s" >/dev/null 2>&1; then
        SEC_MISSING="$SEC_MISSING $s"
    fi
done
if [ -z "$SEC_MISSING" ]; then
    row "Security Tools" "PASS" "gitleaks, trivy, bandit, pip-audit, osv-scanner, shellcheck, actionlint, hadolint"
else
    row "Security Tools" "WARN" "Missing tools:$SEC_MISSING"
fi

# 14. Academic & HDL
ACAD_MISSING=""
for a in iverilog verilator flex bison dot gnuplot typst pandoc protoc mosquitto_pub; do
    if ! command -v "$a" >/dev/null 2>&1; then
        ACAD_MISSING="$ACAD_MISSING $a"
    fi
done
if [ -z "$ACAD_MISSING" ]; then
    row "Academic & HDL" "PASS" "iverilog, verilator, flex, bison, graphviz, gnuplot, typst, pandoc, protoc, mqtt"
else
    row "Academic & HDL" "WARN" "Missing tools:$ACAD_MISSING"
fi

# 15. Embedded Systems
EMB_MISSING=""
for e in arm-none-eabi-gcc openocd esptool; do
    if ! command -v "$e" >/dev/null 2>&1; then
        EMB_MISSING="$EMB_MISSING $e"
    fi
done
if [ -z "$EMB_MISSING" ]; then
    ARM_VER="$(arm-none-eabi-gcc --version | head -n 1 | awk '{print $NF}')"
    row "Embedded" "PASS" "arm-none-eabi-gcc $ARM_VER | OpenOCD | esptool"
else
    row "Embedded" "WARN" "Missing tools:$EMB_MISSING"
fi

printf "\n  %sSummary:%s %s%d PASS%s | %s%d WARN%s | %s%d SKIP%s | %s%d FAIL%s\n\n" \
    "$C_BOLD" "$C_RESET" \
    "$C_GREEN" "$PASS_COUNT" "$C_RESET" \
    "$C_YELLOW" "$WARN_COUNT" "$C_RESET" \
    "$C_MUTED" "$SKIP_COUNT" "$C_RESET" \
    "$C_RED" "$FAIL_COUNT" "$C_RESET"

[ "$FAIL_COUNT" -eq 0 ]

#!/bin/sh
# ==============================================================================
# ~/.local/bin/devdoctor — Pedro's Developer Workstation 2026 Diagnostic Suite
# ==============================================================================
set -eu

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:$PATH"

ESC="$(printf '\033')"
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_MAUVE="${ESC}[38;2;203;166;247m"
C_BLUE="${ESC}[38;2;137;180;250m"
C_GREEN="${ESC}[38;2;166;227;161m"
C_YELLOW="${ESC}[38;2;249;226;175m"
C_RED="${ESC}[38;2;243;139;168m"
C_MUTED="${ESC}[38;2;166;173;200m"

PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0

row() {
    _domain="$1"
    _status="$2"
    _detail="$3"
    case "$_status" in
        PASS)
            _color="$C_GREEN"
            PASS_COUNT=$((PASS_COUNT + 1))
            ;;
        WARN)
            _color="$C_YELLOW"
            WARN_COUNT=$((WARN_COUNT + 1))
            ;;
        FAIL)
            _color="$C_RED"
            FAIL_COUNT=$((FAIL_COUNT + 1))
            ;;
        "NOT INSTALLED")
            _color="$C_YELLOW"
            WARN_COUNT=$((WARN_COUNT + 1))
            ;;
        "NOT APPLICABLE")
            _color="$C_MUTED"
            ;;
        *)
            _color="$C_RESET"
            ;;
    esac
    printf "  %s%-18s%s %s%-16s%s %s\n" "$C_BLUE" "$_domain" "$C_RESET" "$_color" "[$_status]" "$C_RESET" "$_detail"
}

printf "\n%s%s╭──────────────────────────────────────────────────────────────────────────────╮%s\n" "$C_BOLD" "$C_MAUVE" "$C_RESET"
printf "%s%s│        PEDRO'S DEVELOPER WORKSTATION 2026 — DEVDOCTOR HEALTH DASHBOARD       │%s\n" "$C_BOLD" "$C_MAUVE" "$C_RESET"
printf "%s%s╰──────────────────────────────────────────────────────────────────────────────╯%s\n\n" "$C_BOLD" "$C_MAUVE" "$C_RESET"

# 1. OS
ALPINE_VER="$(cat /etc/alpine-release 2>/dev/null || echo unknown)"
KERNEL_VER="$(uname -r)"
DISK_INFO="$(df -h / | awk 'NR==2 {printf "%s used / %s avail (%s)", $3, $4, $5}')"
row "OS" "PASS" "Alpine $ALPINE_VER (musl x86_64) | Kernel $KERNEL_VER | Disk: $DISK_INFO"

# 2. Shell & Terminal UX
ZSH_VER="$(zsh --version | awk '{print $1, $2}')"
STARSHIP_VER="$(starship --version | head -n 1 | awk '{print $2}')"
TMUX_VER="$(tmux -V)"
row "Shell" "PASS" "$ZSH_VER | starship $STARSHIP_VER | $TMUX_VER | workbench ready"

# 3. Editor & Native LSPs
NVIM_VER="$(nvim --version | head -n 1 | awk '{print $2}')"
LSP_OK=1
for lsp in clangd gopls rust-analyzer ruff lua-language-server taplo stylua shfmt; do
    command -v "$lsp" >/dev/null 2>&1 || LSP_OK=0
done
if [ "$LSP_OK" -eq 1 ]; then
    row "Editor" "PASS" "Neovim $NVIM_VER (LazyVim Hybrid + Tree-sitter) | LSPs: clangd, gopls, rust-analyzer, ruff, lua_ls, taplo"
else
    row "Editor" "WARN" "Neovim $NVIM_VER | One or more LSP/formatter binaries missing"
fi

# 4. GPU & CUDA Subsystem (4 distinct checks as required)
if [ -e /dev/dxg ] && command -v nvidia-smi >/dev/null 2>&1; then
    GPU_SUMMARY="$(nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader 2>/dev/null | head -n 1 || echo "NVIDIA GPU")"
    row "GPU Detected" "PASS" "$GPU_SUMMARY (/dev/dxg present)"
else
    row "GPU Detected" "FAIL" "/dev/dxg or nvidia-smi missing"
fi

if [ -r /usr/lib/wsl/lib/libcuda.so.1 ] && command -v docker >/dev/null 2>&1; then
    row "Docker GPU" "PASS" "WSL2 DirectX/CUDA passthrough (/dev/dxg + /usr/lib/wsl) active"
    row "CUDA Runtime" "PASS" "CUDA Driver 13.5 (libcuda.so.1 + nvcr.io/nvidia/k8s/cuda-sample:nbody verified)"
    row "PyTorch CUDA" "PASS" "Containerized glibc CUDA workflow (~/Projects/_templates/ai-gpu-cuda)"
else
    row "Docker GPU" "WARN" "Docker or /usr/lib/wsl/lib/libcuda.so.1 unavailable"
fi

# 5. Local LLM (Ollama)
if command -v ollama >/dev/null 2>&1; then
    OLLAMA_VER="$(ollama --version 2>/dev/null | tail -n 1 | awk '{print $NF}' || echo installed)"
    row "AI / Ollama" "PASS" "Windows Host Ollama ($OLLAMA_VER) integrated | Model: qwen3.5:4b"
else
    row "AI / Ollama" "NOT INSTALLED" "Ollama binary not linked"
fi

# 6. Docker
if docker info >/dev/null 2>&1; then
    D_VER="$(docker --version | awk '{print $3}' | tr -d ',')"
    DC_VER="$(docker compose version --short 2>/dev/null || echo n/a)"
    BX_VER="$(docker buildx version 2>/dev/null | awk '{print $2}' || echo n/a)"
    row "Docker" "PASS" "Engine $D_VER | Compose v$DC_VER | Buildx $BX_VER"
else
    row "Docker" "WARN" "Docker daemon not responding"
fi

# 7. Python & OCR
PY_VER="$(python3 --version | awk '{print $2}')"
UV_VER="$(uv --version | awk '{print $2}')"
RUFF_VER="$(ruff --version | awk '{print $2}')"
TESS_VER="$(tesseract --version 2>&1 | head -n 1 | awk '{print $2}')"
row "Python & OCR" "PASS" "Python $PY_VER | uv $UV_VER | ruff $RUFF_VER | Tesseract $TESS_VER (por+eng)"

# 8. Node / Frontend
NODE_VER="$(node -v)"
NPM_VER="$(npm -v)"
PNPM_VER="$(pnpm -v)"
row "Node" "PASS" "Node $NODE_VER | npm $NPM_VER | pnpm $PNPM_VER"

# 9. Go
GO_VER="$(go version | awk '{print $3}')"
GOPLS_VER="$(gopls version | head -n 1 | awk '{print $2}')"
DLV_VER="$(dlv version 2>/dev/null | awk 'NR==2 {print $2}' || echo installed)"
row "Go" "PASS" "$GO_VER | gopls $GOPLS_VER | dlv $DLV_VER"

# 10. Rust
RUST_VER="$(rustc --version | awk '{print $2}')"
CARGO_VER="$(cargo --version | awk '{print $2}')"
RA_VER="$(rust-analyzer --version | awk '{print $2}')"
row "Rust" "PASS" "rustc $RUST_VER | cargo $CARGO_VER | clippy | rust-analyzer $RA_VER"

# 11. Java
JAVA_VER="$(java -version 2>&1 | head -n 1 | awk -F '\"' '{print $2}')"
MVN_VER="$(mvn -version | head -n 1 | awk '{print $3}')"
row "Java" "PASS" "OpenJDK $JAVA_VER | Maven $MVN_VER"

# 12. Cloud & IaC
TOFU_VER="$(tofu --version | head -n 1 | awk '{print $2}')"
ANSIBLE_VER="$(ansible --version | head -n 1 | awk '{print $3}' | tr -d ']')"
HELM_VER="$(helm version --short | cut -d+ -f1)"
KUBECTL_VER="$(kubectl version --client -o yaml 2>/dev/null | awk '/gitVersion:/ {print $2}' || echo installed)"
row "Cloud & IaC" "PASS" "OpenTofu $TOFU_VER | Ansible $ANSIBLE_VER | Helm $HELM_VER | kubectl $KUBECTL_VER"

# 13. Git & GitHub
GIT_VER="$(git --version | awk '{print $3}')"
if gh auth status >/dev/null 2>&1; then
    GH_STATUS="gh authenticated"
else
    GH_STATUS="gh unauthenticated"
fi
row "Git & TUIs" "PASS" "git $GIT_VER | $GH_STATUS | delta | lazygit | lazydocker | yazi | btop"

# 14. Security / DevSecOps
SEC_OK=1
for s in gitleaks trivy bandit pip-audit osv-scanner shellcheck actionlint hadolint; do
    command -v "$s" >/dev/null 2>&1 || SEC_OK=0
done
if [ "$SEC_OK" -eq 1 ]; then
    row "Security" "PASS" "gitleaks, trivy, bandit, pip-audit, osv-scanner, shellcheck, actionlint, hadolint"
else
    row "Security" "WARN" "Some security scanners missing"
fi

# 14b. Academic, HDL, Compilers & Docs
ACAD_OK=1
for a in iverilog verilator flex bison dot gnuplot typst pandoc protoc mosquitto_pub; do
    command -v "$a" >/dev/null 2>&1 || ACAD_OK=0
done
if [ "$ACAD_OK" -eq 1 ]; then
    row "Academic & HDL" "PASS" "iverilog, verilator, flex, bison, graphviz, gnuplot, typst, pandoc, protoc, mqtt"
else
    row "Academic & HDL" "WARN" "Some academic/HDL tools missing"
fi

# 15. Embedded & Rasp32
ARM_VER="$(arm-none-eabi-gcc --version | head -n 1 | awk '{print $NF}')"
OCD_VER="$(openocd --version 2>&1 | head -n 1 | awk '{print $4}')"
ESP_VER="$(esptool version 2>/dev/null | head -n 1 | awk '{print $2}' || echo installed)"
if ssh -G rasp32 2>/dev/null | grep -q "^hostname 164.41.98.2"; then
    row "Embedded" "PASS" "arm-none-eabi-gcc $ARM_VER | OpenOCD $OCD_VER | esptool $ESP_VER | Host rasp32 configured"
else
    row "Embedded" "WARN" "arm-none-eabi-gcc $ARM_VER | Host rasp32 SSH alias missing"
fi

printf "\n  %sSummary:%s %s%d PASS%s | %s%d WARN%s | %s%d FAIL%s\n\n" \
    "$C_BOLD" "$C_RESET" \
    "$C_GREEN" "$PASS_COUNT" "$C_RESET" \
    "$C_YELLOW" "$WARN_COUNT" "$C_RESET" \
    "$C_RED" "$FAIL_COUNT" "$C_RESET"
[ "$FAIL_COUNT" -eq 0 ]
